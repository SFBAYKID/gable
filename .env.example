# ============================================================================
# Gable — environment configuration
# ============================================================================
#
# Copy to .env and fill in real values:   cp .env.example .env
#
# .env MUST stay in .gitignore. On the droplet:
#   chmod 600 .env && chown gable:gable .env
#
# Every variable the code reads appears here. If you add a config read, add it
# here in the same commit, with a comment explaining it. `tests/` asserts that
# any credential-shaped name here is also in logging_setup.SECRET_ENV_VARS, so
# a new key cannot be added without also being redacted from logs.
#
# WHAT GABLE DOES
#   Watches the listing intake Sheet. For each new request it resolves a photo,
#   verifies the agent's contact details, picks their template, renders a
#   finished post with Google Slides, and posts it to Slack for Carmen. She
#   either edits the live Slides file herself or replies in the thread and the
#   agent re-renders.
# ============================================================================


# ---------------------------------------------------------------------------
# Slack
# ---------------------------------------------------------------------------

# Bot User OAuth Token (xoxb-). OAuth & Permissions, after installing the app.
# This is what Gable authenticates every Web API call with.
SLACK_BOT_TOKEN=

# App-Level Token (xapp-). Basic Information -> App-Level Tokens, scope
# connections:write. Opens the Socket Mode WebSocket. Not interchangeable with
# the bot token — Gable needs both.
SLACK_APP_TOKEN=

# Basic Information -> Signing Secret. Unused under Socket Mode, which has no
# inbound requests to verify. Required only if Gable ever moves to HTTP events.
SLACK_SIGNING_SECRET=

# Basic Information -> App Credentials. NOT needed to run: these drive the
# OAuth install flow, which matters only if Gable is ever installed to a second
# workspace. Kept so a future distribution does not need a scavenger hunt.
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=

# Identifiers, not credentials. SLACK_APP_ID is NOT a duplicate of
# SLACK_CLIENT_ID — the app id names the app in Slack's UI and deep links
# (slack://app?id=...), the client id is the public half of the OAuth pair.
# Both are reference-only; no code path reads them today.
SLACK_APP_ID=A0BNWTFQ4KZ
SLACK_TEAM_ID=T01DFJLFKE3

# The only channel Gable posts to. It never messages anywhere else.
GABLE_SLACK_CHANNEL_ID=C0BP597644B


# ---------------------------------------------------------------------------
# Google — one service account for Sheets, Drive and Slides
# ---------------------------------------------------------------------------
#
# SETUP, in order. Skipping any step produces a confusing 403 later:
#   1. Google Cloud console -> create a service account, download the JSON key.
#   2. Enable all three APIs on that project: Sheets, Drive, Slides.
#   3. Share the intake Sheet with the account's client_email as Editor.
#   4. Add that same client_email to the "Gable" shared drive as Content
#      manager. A service account inherits nothing; both shares are required.

# Absolute path to the service-account JSON key. Keep it OUTSIDE the repo tree.
# On the droplet: /opt/gable/secrets/ (the systemd unit sets ProtectHome=true,
# so /home is unreadable to the service — /opt is deliberate).
# Locally, point this anywhere outside the repo.
GOOGLE_SERVICE_ACCOUNT_FILE=/opt/gable/secrets/gable-service-account.json


# ---------------------------------------------------------------------------
# Google Sheets — the intake form and the datastore
# ---------------------------------------------------------------------------

# "Social Media and Marketing Request Form (Responses)".
# From https://docs.google.com/spreadsheets/d/<THIS PART>/edit
GABLE_SHEET_ID=1HxgGAo_3OT0Lg9b0R-6bcJKEpgXzxxQmLKoZXTx2ZFQ

# The tab holding form submissions, read-only and never written. Columns are
# found by header text, so a renamed or reordered question needs no change here;
# a tab whose header names none of the email, request type and address is
# refused rather than guessed at.
#
# The agent roster is NOT a tab any more. It lives in the drive beside the
# templates, in Agents Contact Information, and run records live in SQLite.
GABLE_TAB_RESPONSES=Form Responses 1


# ---------------------------------------------------------------------------
# Google Drive — templates, photos, output
# ---------------------------------------------------------------------------
#
# MUST be a shared drive, not a My Drive folder. Service accounts have a 0 GB
# storage quota, so any file they create outside a shared drive fails with
# StorageQuotaExceeded on the very first render. Config rejects a non-shared
# drive id at startup rather than letting that surface at runtime.

# The "Gable" shared drive.
GABLE_DRIVE_ID=0AE0VE3GY-xguUk9PVA

# Template pairs: the filled reference and the blank background it was built
# from.
GABLE_DRIVE_TEMPLATES_FOLDER_ID=1lW6pB8ZNEMZlcCVOIB8TtyzZkV4WFBdI

# Generated posts, one Slides file per request. This is what Carmen's Slack
# link points at.
GABLE_DRIVE_OUTPUT_FOLDER_ID=


# ---------------------------------------------------------------------------
# Rendering — Google Slides
# ---------------------------------------------------------------------------

# Output canvas. The Corner House template library is Instagram Post 4:5,
# confirmed 1080 x 1350 px on export.
GABLE_SLIDE_WIDTH_PX=1080
GABLE_SLIDE_HEIGHT_PX=1350

# Slides caps an inserted image URL at 2 kB and accepts PNG/JPEG/GIF only, up
# to 50 MB and 25 megapixels. Enforced before the request is sent, so a bad URL
# fails with a sentence instead of a Google error code.
GABLE_MAX_IMAGE_URL_BYTES=2048


# ---------------------------------------------------------------------------
# Firecrawl — agent contact verification and web photo search
# ---------------------------------------------------------------------------
#
# Optional. Blank disables verification entirely: the listing is flagged and
# the run continues rather than failing.
FIRECRAWL_API_KEY=

# Hours to cache a brokerage page. Every agent at the same brokerage would
# otherwise refetch the same page.
GABLE_VERIFY_CACHE_HOURS=24


# ---------------------------------------------------------------------------
# Photos — the cascade, and what AI may do to them
# ---------------------------------------------------------------------------
#
# Two DIFFERENT operations, on deliberately separate code paths:
#
#   REPROCESS  Take a real photo the agent supplied and make it fit the
#              template — crop to the frame's aspect ratio, straighten,
#              correct exposure, upscale. The subject is unchanged. This is
#              the common case, and the reason an image key is needed at all.
#
#   GENERATE   Invent a photo when none exists. An image model cannot know what
#              a specific address looks like, so this puts a factually wrong
#              photograph on marketing for a real property someone can drive
#              to. Policy-gated, off by default, always disclosed.

# retrieve_only          Never generate. Reprocessing still allowed.
# generate_with_approval Generate only as a last resort, and only after Carmen
#                        approves it in Slack.  [DEFAULT]
# generate_freely        Generate whenever retrieval fails, no approval gate.
# no_ai                  Neither generate nor reprocess. Photo used as found.
GABLE_PHOTO_POLICY=generate_with_approval

# Below this confidence Gable asks Carmen instead of using the photo. A post
# with no photo gets caught; a post with the wrong house ships.
GABLE_PHOTO_MIN_CONFIDENCE=0.75

# Reprocess a real photo to fit the template frame. Policy wins over this flag:
# no_ai disables it whatever this says.
GABLE_PHOTO_REPROCESS=true

# Hard ceiling on image-model calls per listing. An agent that can spend money
# in a loop needs the limit in code, not in a comment.
GABLE_MAX_IMAGE_CALLS_PER_LISTING=1

# Long edge after normalization, and JPEG quality. The template's hero frame is
# 1080 px wide, so anything past ~2400 is wasted bytes on a small droplet.
GABLE_PHOTO_MAX_EDGE_PX=2400
GABLE_PHOTO_JPEG_QUALITY=85

# Slack uploads are fitted locally, then written into nginx's document root on
# the droplet. Google Slides was verified to accept this plain HTTP host. The
# root must also appear in deploy/gable.service ReadWritePaths.
GABLE_PHOTO_PUBLIC_ROOT=/var/www/gable-photos
GABLE_PHOTO_PUBLIC_BASE=http://143.110.146.87


# ---------------------------------------------------------------------------
# Optional overflow photo hosting — DigitalOcean Spaces uses HTTPS
# ---------------------------------------------------------------------------
#
# Slides fetches an image once at insertion and stores it inside the
# presentation, so the URL only has to be reachable for that moment. It must be
# public: a Drive link requires auth and will not work.
#
# DigitalOcean Spaces is the fallback if the droplet's local disk stops being
# sufficient. The current live path uses GABLE_PHOTO_PUBLIC_ROOT above.
SPACES_KEY=
SPACES_SECRET=
SPACES_REGION=nyc3
SPACES_BUCKET=gable-photos
SPACES_PUBLIC_BASE=


# ---------------------------------------------------------------------------
# Pipeline behaviour
# ---------------------------------------------------------------------------

# Socket Mode gives no public endpoint, so there is no webhook option and the
# Sheet is polled. At a handful of requests a day this is indistinguishable
# from a webhook and far simpler.
#
# Two rates. Requests arrive during the working day, so polling at the busy rate
# at 3am just burns Sheets quota to find nothing.
#   busy   Every day 07:00-21:00 US Central (7am Central through 7pm Pacific;
#          evaluated in Central, not droplet local time)
#   quiet  everything else
GABLE_POLL_BUSY_INTERVAL_SECONDS=120
GABLE_POLL_INTERVAL_SECONDS=600

# Whether to watch the Sheet at all. Set false to serve Slack without acting on
# submissions — the conversation can then be exercised on its own before the
# system is trusted to build flyers unattended. The backfill guard is skipped in
# that mode, because it exists to stop a first boot building every historical
# row and nothing is being built.
GABLE_POLL_ENABLED=true

# Max requests processed per cycle, so a backfill cannot exhaust the droplet.
GABLE_MAX_BATCH=25

# Truncate long text on a word boundary and flag that it happened, so Carmen
# knows to check the layout.
GABLE_MAX_DESCRIPTION_CHARS=400

# Attempts before a request is failed loudly and skipped. Retry storms on a
# small droplet take the whole process down.
GABLE_MAX_RETRIES=3

# Do everything except write to Sheets/Drive or post to Slack. Use this for the
# first live run.
GABLE_DRY_RUN=true


# ---------------------------------------------------------------------------
# AI providers
# ---------------------------------------------------------------------------

# OpenAI. ONE key, THREE jobs: the conversation with Carmen, the vision pass
# over a rendered post, and image reprocessing. Verified 2026-08-10 that this
# key reaches both /v1/chat/completions and the images endpoint. Blank disables
# all three — the cascade ends at "ask Carmen", and Gable never implies it could
# have produced an image.
OPENAI_IMAGE_API_KEY=

# --- Model selection. Prices are per MILLION TOKENS, taken from each vendor's
# --- own pricing page on 2026-08-10. Full comparison in ARCHITECTURE.md.

# Conversation and tool-picking: reads Carmen's plain English, chooses which
# tool to call, fills the arguments. Highest-volume path — every Slack turn —
# so this is where cost compounds.
#   gpt-5-mini   $0.25 in / $2.00 out   <- chosen
#   haiku-4.5    $1.00 / $5.00           4x the input cost
#   sonnet-5     $2.00 / $10.00          8x, and rises to $3/$15 on 2026-09-01
#   opus-5       $5.00 / $25.00         20x
GABLE_CONVERSATION_MODEL=gpt-5-mini

# The vision pass that inspects a rendered post before delivering it (§4.7b).
# Same key, same model — gpt-5-mini has vision. If it proves unreliable at
# judging "is the roofline cropped", escalate to gpt-5 ($1.25/$10), still 4x
# under opus-5.
GABLE_VISION_MODEL=gpt-5-mini

# Image reprocessing. Read this before assuming a model is needed: cropping and
# resizing a photo to fit a frame is DETERMINISTIC, done locally with Pillow for
# $0 and no latency. A model is only called when pixels must be INVENTED —
# upscaling a photo too small for the frame. That makes this the rare path.
#   gpt-image-1-mini  $2.50 in / $8.00 out  <- chosen; 3.75x under gpt-image-2
#   gpt-image-2       $8.00 / $30.00        high-fidelity upscale for tiny real photos
#   gpt-image-1       $10.00 / $40.00       older AND dearer; never use
GABLE_IMAGE_MODEL=gpt-image-1-mini
# A real property photo needing more than 2x enlargement uses this model
# directly because factual fidelity matters more than draft-generation cost.
GABLE_IMAGE_MODEL_HQ=gpt-image-2

# Anthropic. Kept as the documented escalation path for the conversation and
# vision jobs if gpt-5-mini proves too weak at tool-picking. Not used by
# default — see GABLE_CONVERSATION_MODEL for the reasoning.
ANTHROPIC_API_KEY=

# Sonnet 5 rather than Opus 5: 2.5x cheaper on both sides and sufficient here.
GABLE_ANTHROPIC_MODEL=claude-sonnet-5


# ---------------------------------------------------------------------------
# Local datastore
# ---------------------------------------------------------------------------

# Where Gable keeps its own record: which submissions it has seen, what it
# looked up, what it rendered, and what each run cost. SQLite rather than a
# server, because a hundred submissions a month does not justify a second
# daemon to run, back up and patch. The service can write only under var, and
# SQLite also creates its WAL and shared-memory files beside the database.
GABLE_DB_PATH=/opt/gable/var/gable.db


# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------

# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# json to journald in production; console is easier locally.
LOG_FORMAT=json

# Redaction is a mechanism, not a preference. Setting this false is refused at
# startup while any secret is present in the environment.
LOG_REDACT_SECRETS=true
