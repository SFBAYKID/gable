# Gable runtime configuration
#
# Copy this file to .env, fill the blank values, and keep .env out of git.
# On the droplet, .env is owned by gable with mode 600. Every variable read by
# Settings appears here; settings that have no runtime consumer are omitted.

# Slack Socket Mode. Gable posts only to this configured channel.
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
GABLE_SLACK_CHANNEL_ID=C0BP597644B
# Stable Slack user IDs for Carmen and Chase, comma-separated. Gable ignores
# every mention, thread reply, photo, and command from anyone else.
GABLE_SLACK_ALLOWED_USER_IDS=

# One service account shared with the intake Sheet and the Gable shared drive.
# The key file stays outside the repository.
GOOGLE_SERVICE_ACCOUNT_FILE=/opt/gable/secrets/gable-service-account.json
GABLE_SHEET_ID=
GABLE_TAB_RESPONSES=Form Responses 1
GABLE_DRIVE_ID=
GABLE_DRIVE_TEMPLATES_FOLDER_ID=
GABLE_DRIVE_OUTPUT_FOLDER_ID=

# Slides canvas used to convert exact source geometry into pixel dimensions.
GABLE_SLIDE_WIDTH_PX=1080
GABLE_SLIDE_HEIGHT_PX=1350

# Property and agent research. Current production startup requires this key.
FIRECRAWL_API_KEY=

# A supplied real photo is always kept as the source of truth. retrieve_only
# permits local fitting and fidelity-gated enlargement; no_ai also disables the
# paid enlargement. Synthetic property-photo generation is not connected.
GABLE_PHOTO_POLICY=retrieve_only
GABLE_PHOTO_REPROCESS=true
GABLE_MAX_IMAGE_CALLS_PER_LISTING=1
GABLE_PHOTO_MAX_EDGE_PX=2400
GABLE_PHOTO_JPEG_QUALITY=85
GABLE_PHOTO_PUBLIC_ROOT=/var/www/gable-photos
GABLE_PHOTO_PUBLIC_BASE=http://143.110.146.87

# Sheet polling. Busy means every day from 07:00 through 21:00 US Central.
GABLE_POLL_BUSY_INTERVAL_SECONDS=120
GABLE_POLL_INTERVAL_SECONDS=600
GABLE_POLL_ENABLED=true
GABLE_MAX_BATCH=25

# Legacy switch. true is rejected because it never isolated Drive and Slack.
# Use GABLE_POLL_ENABLED=false for a conversation-only process.
GABLE_DRY_RUN=false

# One OpenAI key powers Slack intent routing, final visual inspection, and the
# rare enlargement of a supplied photo beyond 2x. It never generates a house.
OPENAI_IMAGE_API_KEY=
GABLE_CONVERSATION_MODEL=gpt-5.6-sol
GABLE_VISION_MODEL=gpt-5.6-sol
GABLE_IMAGE_MODEL_HQ=gpt-image-2

# Local derived state, event history, and the hard spend ledger.
GABLE_DB_PATH=/opt/gable/var/gable.db

# Logging. Redaction cannot be disabled.
LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_REDACT_SECRETS=true
