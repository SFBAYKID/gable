# Gable runtime configuration
#
# Copy this file to .env, fill the blank values, and keep .env out of git.
# On the droplet, .env is owned by gable with mode 600. Every variable read by
# Settings appears here; settings that have no runtime consumer are omitted.

# Slack Socket Mode. Gable posts only to this configured channel.
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
GABLE_SLACK_CHANNEL_ID=C0BP597644B
# Stable Slack user IDs for Carmen and Chase, comma-separated. Gable ignores
# every mention, thread reply, and photo from anyone else, silently. At least
# two and at most six: a person may hold more than one account, and Carmen posts
# from a guest account rather than the workspace one she was first configured
# with. Check the ID a person actually posts from, not the one that shares their
# display name.
GABLE_SLACK_ALLOWED_USER_IDS=

# One service account shared with the intake Sheet and the Gable shared drive.
# The key file stays outside the repository.
GOOGLE_SERVICE_ACCOUNT_FILE=/opt/gable/secrets/gable-service-account.json
GABLE_SHEET_ID=
GABLE_TAB_RESPONSES=Form Responses 1
GABLE_DRIVE_ID=
GABLE_DRIVE_TEMPLATES_FOLDER_ID=
GABLE_DRIVE_OUTPUT_FOLDER_ID=

# Slides canvas used to convert exact source geometry into pixel dimensions.
GABLE_SLIDE_WIDTH_PX=1080
GABLE_SLIDE_HEIGHT_PX=1350

# Property and agent research. Current production startup requires this key.
FIRECRAWL_API_KEY=

# The credential every agent at this brokerage holds, printed on designs that
# have an agent-title field when that agent's own profile on the official site
# leaves its job title blank. A profile that states a title always wins. Chase
# confirmed on 2026-08-19 that all 38 agents on the roster hold it. Write it in
# title case: a design that sets its credential in capitals gets them applied
# for it, and a capitalised value is never lowered, so REALTOR here goes into a
# "Realtor" box too wide to fit and the flyer shrinks the type. Set this
# empty to restore the older rule, under which a blank profile title stops the
# run and the flyer is not built at all.
GABLE_DEFAULT_AGENT_CREDENTIAL=Realtor

# A supplied real photo is always kept as the source of truth. Both supported
# policies use only deterministic local fitting; generation values are rejected.
GABLE_PHOTO_POLICY=retrieve_only
GABLE_PHOTO_MAX_EDGE_PX=2400
GABLE_PHOTO_JPEG_QUALITY=85
GABLE_PHOTO_PUBLIC_ROOT=/var/www/gable-photos
GABLE_PHOTO_PUBLIC_BASE=http://143.110.146.87

# Sheet polling. Busy means every day from 07:00 through 21:00 US Central.
GABLE_POLL_BUSY_INTERVAL_SECONDS=120
GABLE_POLL_INTERVAL_SECONDS=600
GABLE_POLL_ENABLED=true
GABLE_MAX_BATCH=25

# Legacy switch. true is rejected because it never isolated Drive and Slack.
# Use GABLE_POLL_ENABLED=false for a conversation-only process.
GABLE_DRY_RUN=false

# One OpenAI key powers Slack intent routing and final visual inspection. The
# property-photo fitting path does not call an image model.
OPENAI_IMAGE_API_KEY=
GABLE_CONVERSATION_MODEL=gpt-5.6-sol
GABLE_VISION_MODEL=gpt-5.6-sol

# Local derived state, event history, and the hard spend ledger.
GABLE_DB_PATH=/opt/gable/var/gable.db

# Total dollars this process may reserve for paid calls, enforced against the
# ledger in the database above. Reaching it stops the run rather than warning.
# Leave it at the default for ordinary operation; a deliberate test campaign
# across every design and salesperson runs against its own database and raises
# this for that database only.
GABLE_SPEND_CEILING_USD=50

# Logging. Redaction cannot be disabled.
LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_REDACT_SECRETS=true
