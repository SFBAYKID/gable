# ============================================================================
# Gable — environment configuration
# ============================================================================
#
# Copy to .env and fill in real values:   cp .env.example .env
#
# .env MUST be in .gitignore. Verified before commit #1.
# On the droplet:  chmod 600 .env  &&  chown gable:gable .env
#
# Every variable the code reads appears here. If you add a config read,
# add it here in the same commit, with a comment explaining it.
#
# ARCHITECTURE NOTE (2026-08-10): the renderer is Google Slides, not Canva.
# Spike A proved an uploaded CSV/XLSX cannot carry an image column into Canva
# Bulk Create, and Bulk Create is a human-operated UI with no API — so an agent
# can never drive it. Canva Connect autofill can, but needs Enterprise
# (~25-seat minimum). Slides does text + images from a public URL, costs
# nothing on Workspace, and the output is a live document Carmen can open and
# edit. See spikes/SPIKE_A_RESULT.md and ARCHITECTURE.md's decision log.
# ============================================================================


# ---------------------------------------------------------------------------
# Slack
# ---------------------------------------------------------------------------

# Bot User OAuth Token. OAuth & Permissions page, after installing to workspace.
SLACK_BOT_TOKEN=

# App-Level Token for Socket Mode. Basic Information -> App-Level Tokens,
# with the connections:write scope. Not the same as the bot token.
SLACK_APP_TOKEN=

# Basic Information -> Signing Secret. Not used by Socket Mode today, but
# required if you ever switch to HTTP events. Keep it set.
SLACK_SIGNING_SECRET=

# The only channel Gable posts to.
GABLE_SLACK_CHANNEL_ID=C0BP597644B


# ---------------------------------------------------------------------------
# Google — service account
# ---------------------------------------------------------------------------
#
# One service account covers Sheets, Drive, and Slides. Enable all three APIs
# in the Cloud project, then share the Sheet AND the Gable shared drive with
# the account's client_email. It inherits nothing.

# Absolute path to the service-account JSON key.
# Store it OUTSIDE the repo tree. /opt/gable/secrets/ is a reasonable home —
# note ProtectHome=true in the systemd unit blocks /home, so prefer /opt.
GOOGLE_SERVICE_ACCOUNT_FILE=/opt/gable/secrets/gable-service-account.json


# ---------------------------------------------------------------------------
# Google Sheets — the intake and the datastore
# ---------------------------------------------------------------------------

# "Social Media and Marketing Request Form (Responses)".
# From https://docs.google.com/spreadsheets/d/<THIS PART>/edit
GABLE_SHEET_ID=1HxgGAo_3OT0Lg9b0R-6bcJKEpgXzxxQmLKoZXTx2ZFQ

# Tab names. `Form Responses 1` is read-only and never written.
# `Agents`, `Runs`, and `Templates` do not exist yet — Chase to confirm before
# they are created (additive only).
GABLE_TAB_RESPONSES=Form Responses 1
GABLE_TAB_AGENTS=Agents
GABLE_TAB_RUNS=Runs
GABLE_TAB_TEMPLATES=Templates


# ---------------------------------------------------------------------------
# Google Drive — the template catalog and the output
# ---------------------------------------------------------------------------
#
# MUST be a Shared Drive, not a My Drive folder. Service accounts have a 0 GB
# storage quota, so any file they create in a normal folder fails with
# StorageQuotaExceeded. Files in a Shared Drive are owned by the drive.

# The "Gable" shared drive. Created 2026-08-10.
GABLE_DRIVE_ID=0AE0VE3GY-xguUk9PVA

# Template pairs: "1" (filled reference) and "1A" (blank background).
GABLE_DRIVE_TEMPLATES_FOLDER_ID=1lW6pB8ZNEMZlcCVOIB8TtyzZkV4WFBdI

# Listing photos and agent headshots.
GABLE_DRIVE_PHOTOS_FOLDER_ID=

# Generated posts land here, one Slides file per listing.
GABLE_DRIVE_OUTPUT_FOLDER_ID=


# ---------------------------------------------------------------------------
# Rendering — Google Slides
# ---------------------------------------------------------------------------

# Canvas size of the generated post. The Corner House template library is
# Instagram Post 4:5, verified 1080 x 1350 px on export.
GABLE_SLIDE_WIDTH_PX=1080
GABLE_SLIDE_HEIGHT_PX=1350

# Slides caps an inserted image URL at 2 kB and accepts PNG/JPEG/GIF only,
# max 50 MB and 25 megapixels. Enforced in slides/renderer.py.
GABLE_MAX_IMAGE_URL_BYTES=2048


# ---------------------------------------------------------------------------
# Firecrawl — agent contact verification
# ---------------------------------------------------------------------------
#
# Optional. Leave blank to skip verification entirely; the listing is flagged
# and the run continues.

FIRECRAWL_API_KEY=

# Hours to cache a brokerage page before refetching. Every agent at the same
# brokerage would otherwise refetch the same page.
GABLE_VERIFY_CACHE_HOURS=24


# ---------------------------------------------------------------------------
# Photo policy  —  see CLAUDE.md section 8 before changing this
# ---------------------------------------------------------------------------

# retrieve_only          Never generate. AI may enhance a real photo.
# generate_with_approval Generate only as a last resort, and only after
#                        Carmen explicitly approves it in Slack.  [DEFAULT]
# generate_freely        Generate whenever retrieval fails, no approval gate.
# no_ai                  No generation and no enhancement. Photo used as found.
#
# An image model cannot know what a specific address looks like, so a generated
# house is a factually wrong photograph of a real for-sale property.
# Enhancement of a REAL photo is a different operation and stays allowed.
GABLE_PHOTO_POLICY=generate_with_approval

# Below this confidence, Gable asks Carmen rather than using the photo.
# A flyer with no photo gets caught. A flyer with the wrong house ships.
GABLE_PHOTO_MIN_CONFIDENCE=0.75

# Enhancement of a real retrieved photo (exposure, straighten, upscale, sky).
# Policy wins over this flag: GABLE_PHOTO_POLICY=no_ai disables enhancement
# whatever this says, rather than making you edit two variables to say one thing.
GABLE_PHOTO_ENHANCE=true

# Image provider, used for enhancement and (if policy permits) generation.
# One of: openai | gemini | none
#
# A provider named here with a BLANK key is treated as "no usable provider",
# not as a broken config. Gable still starts; the photo cascade simply ends at
# "ask Carmen" and Gable never claims it could have generated something.
#
# The one combination that refuses to start is GABLE_PHOTO_POLICY=generate_freely
# with no usable provider: that asks for automatic generation with nothing to
# generate with.
GABLE_IMAGE_PROVIDER=none
OPENAI_API_KEY=
GEMINI_API_KEY=

# Hard ceiling. An agent that can spend money in a loop needs a limit in code.
GABLE_MAX_IMAGE_CALLS_PER_LISTING=1


# ---------------------------------------------------------------------------
# Photo hosting — Slides needs a public HTTPS URL
# ---------------------------------------------------------------------------
#
# Google Slides fetches the image once at insertion and stores it inside the
# presentation, so the URL only has to be reachable for that moment. It still
# must be public: a Drive link requires auth and will not work.
#
# DigitalOcean Spaces is S3-compatible and the recommended host.

SPACES_KEY=
SPACES_SECRET=
SPACES_REGION=nyc3
SPACES_BUCKET=gable-photos
SPACES_PUBLIC_BASE=

# Long edge in pixels after normalization. The template's hero frame is
# 1080 px wide, so anything past ~2400 is wasted bytes on a small droplet.
GABLE_PHOTO_MAX_EDGE_PX=2400
GABLE_PHOTO_JPEG_QUALITY=85


# ---------------------------------------------------------------------------
# Pipeline behavior
# ---------------------------------------------------------------------------

# Sheet poll interval. Socket Mode gives no public endpoint, so there is no
# webhook option — see ARCHITECTURE.md section 2.2.
GABLE_POLL_INTERVAL_SECONDS=180

# Max listings processed per cycle, so a backfill cannot exhaust the droplet.
GABLE_MAX_BATCH=25

# Truncate descriptions on a word boundary at this length, and flag when it
# happened so Carmen knows to check the layout.
GABLE_MAX_DESCRIPTION_CHARS=400

# Attempts before a listing is failed loudly and skipped.
GABLE_MAX_RETRIES=3

# Do everything except write to Sheets/Drive or post to Slack.
# Use this for the first live run.
GABLE_DRY_RUN=true


# ---------------------------------------------------------------------------
# Canva — spike only, NOT used by the pipeline
# ---------------------------------------------------------------------------
#
# Kept for canva_autofill_spike.py, which measures the autofill trial quota.
# Autofill needs a Canva Enterprise organization (~25-seat minimum), which was
# ruled out on cost. Leave blank unless running that spike.
CANVA_CLIENT_ID=
CANVA_CLIENT_SECRET=
CANVA_REDIRECT_URI=http://127.0.0.1:8910/callback


# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------

# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# JSON to journald in production; console is easier locally.
LOG_FORMAT=json

# Secret redaction is enforced by a filter in logging_setup.py, not by
# remembering to be careful. Setting this false is refused at startup.
LOG_REDACT_SECRETS=true
