# ============================================================================
# Gable — environment configuration
# ============================================================================
#
# Copy to .env and fill in real values:   cp .env.example .env
#
# .env MUST be in .gitignore. Verify that before your first commit.
# On the droplet:  chmod 600 .env  &&  chown gable:gable .env
#
# Every variable the code reads appears here. If you add a config read,
# add it here in the same commit, with a comment explaining it.
# ============================================================================


# ---------------------------------------------------------------------------
# Slack
# ---------------------------------------------------------------------------

# Bot User OAuth Token. OAuth & Permissions page, after installing to workspace.
SLACK_BOT_TOKEN=xoxb-

# App-Level Token for Socket Mode. Basic Information -> App-Level Tokens,
# with the connections:write scope. Not the same as the bot token.
SLACK_APP_TOKEN=xapp-

# Basic Information -> Signing Secret. Not used by Socket Mode today, but
# required if you ever switch to HTTP events. Keep it set.
SLACK_SIGNING_SECRET=

# The only channel Gable posts to. Provided by Chase.
GABLE_SLACK_CHANNEL_ID=C0BP597644B


# ---------------------------------------------------------------------------
# Google
# ---------------------------------------------------------------------------

# Absolute path to the service-account JSON key.
# Store it OUTSIDE the repo tree. /home/gable/secrets/ is a reasonable home.
GOOGLE_SERVICE_ACCOUNT_FILE=/home/gable/secrets/gable-service-account.json

# The listing intake workbook.
# From https://docs.google.com/spreadsheets/d/<THIS PART>/edit
GABLE_SHEET_ID=1HxgGAo_3OT0Lg9b0R-6bcJKEpgXzxxQmLKoZXTx2ZFQ

# Tab names. Confirm these against the live workbook before coding —
# Google Forms names its tab, and the name is easy to get wrong.
GABLE_TAB_RESPONSES=Form Responses 1
GABLE_TAB_AGENTS=Agents
GABLE_TAB_RUNS=Runs

# Shared Drive folder holding listing photos, if you use one.
# Folder ID from https://drive.google.com/drive/folders/<THIS PART>
GABLE_DRIVE_PHOTOS_FOLDER_ID=

# The service account must be granted access explicitly. Share the Sheet
# (and the Drive folder) with the service account's client_email as Editor.
# It will not inherit Chase's access.


# ---------------------------------------------------------------------------
# Firecrawl — agent contact verification
# ---------------------------------------------------------------------------

FIRECRAWL_API_KEY=

# Hours to cache a brokerage page before refetching. Every agent at the same
# brokerage would otherwise refetch the same page.
GABLE_VERIFY_CACHE_HOURS=24


# ---------------------------------------------------------------------------
# Photo policy  —  see CLAUDE.md section 8 before changing this
# ---------------------------------------------------------------------------

# retrieve_only          Never generate. AI may enhance a real photo.
# generate_with_approval Generate only as a last resort, and only after
#                        Carmen explicitly approves it in Slack.  [DEFAULT]
# generate_freely        Generate whenever retrieval fails, no approval gate.
# no_ai                  No generation and no enhancement. Photo used as found.
#
# Chase has not settled this. The default is the conservative reading:
# an image model cannot know what a specific address looks like, so a generated
# house is a factually wrong photograph of a real for-sale property.
# Enhancement of a REAL photo is a different operation and stays allowed.
GABLE_PHOTO_POLICY=generate_with_approval

# Below this confidence, Gable asks Carmen rather than using the photo.
# A flyer with no photo gets caught. A flyer with the wrong house ships.
GABLE_PHOTO_MIN_CONFIDENCE=0.75

# Enhancement of a real retrieved photo (exposure, straighten, upscale, sky).
GABLE_PHOTO_ENHANCE=true

# Image provider, used for enhancement and (if policy permits) generation.
# One of: openai | gemini | none
GABLE_IMAGE_PROVIDER=openai
OPENAI_API_KEY=
GEMINI_API_KEY=

# Hard ceiling. An agent that can spend money in a loop needs a limit in code.
GABLE_MAX_IMAGE_CALLS_PER_LISTING=1


# ---------------------------------------------------------------------------
# Photo hosting — Canva needs a public HTTPS URL
# ---------------------------------------------------------------------------
#
# Verified from Canva's Apps SDK docs: image cells take an external HTTPS URL,
# max 4096 characters, JPEG/PNG/WebP/SVG+XML/HEIC/TIFF, 50MB ceiling.
#
# DigitalOcean Spaces is S3-compatible and the recommended host.

SPACES_KEY=
SPACES_SECRET=
SPACES_REGION=nyc3
SPACES_BUCKET=gable-photos
SPACES_PUBLIC_BASE=https://gable-photos.nyc3.digitaloceanspaces.com

# Long edge in pixels after normalization. Keep modest: the droplet is small
# and Canva does not need a 6000px original.
GABLE_PHOTO_MAX_EDGE_PX=2400
GABLE_PHOTO_JPEG_QUALITY=85


# ---------------------------------------------------------------------------
# Pipeline behavior
# ---------------------------------------------------------------------------

# Sheet poll interval. Socket Mode gives no public endpoint, so there is no
# webhook option — see ARCHITECTURE.md section 2.2.
GABLE_POLL_INTERVAL_SECONDS=180

# Max listings processed per cycle, so a backfill cannot exhaust the droplet.
GABLE_MAX_BATCH=25

# Truncate descriptions on a word boundary at this length, and flag when it
# happened so Carmen knows to check the layout. Canva's own string cell limit
# is 10,000 chars; the real constraint is the template's text box.
GABLE_MAX_DESCRIPTION_CHARS=400

# Attempts before a listing is failed loudly and skipped.
GABLE_MAX_RETRIES=3

# Do everything except write to Sheets, upload files, or post to Slack.
# Use this for the first live run.
GABLE_DRY_RUN=false


# ---------------------------------------------------------------------------
# Canva — Phase 2 / autofill spike only, not needed for Phase 1
# ---------------------------------------------------------------------------
#
# Autofill requires a Canva Enterprise organization. The account is on Teams,
# so these are for the trial spike only. See CLAUDE.md section 4.
CANVA_CLIENT_ID=
CANVA_CLIENT_SECRET=
CANVA_REDIRECT_URI=http://127.0.0.1:8910/callback


# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------

# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# JSON to journald in production; console is easier locally.
LOG_FORMAT=json

# Secret redaction is enforced by a filter in logging_setup.py, not by
# remembering to be careful. Leave this on.
LOG_REDACT_SECRETS=true
