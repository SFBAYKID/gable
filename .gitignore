# ---------------------------------------------------------------------------
# Secrets — nothing here ever reaches a commit.
# CLAUDE.md section 3: verify this file before commit #1.
# ---------------------------------------------------------------------------
.env
.env.*
!.env.example

# Google service-account keys. Named several ways in the wild; block all of
# them, and keep the real key outside the repo tree entirely (ARCHITECTURE.md
# section 7).
*service-account*.json
*service_account*.json
*-key.json
credentials.json
client_secret*.json

# ---------------------------------------------------------------------------
# Python
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
env/

# ---------------------------------------------------------------------------
