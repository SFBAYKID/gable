# Gable — systemd unit.
#
# Install:  see deploy/PROVISION.md. Do not edit this file on the server;
# change it here, commit, and `make deploy` (CLAUDE.md section 9).
#
# Socket Mode means this process opens an OUTBOUND WebSocket and listens on
# nothing. No ports are opened, so there is no listener to harden.

[Unit]
Description=Gable — listing form submissions to finished social posts
Documentation=file:///opt/gable/ARCHITECTURE.md
After=network-online.target
Wants=network-online.target

# Rate limiting lives in [Unit], NOT [Service]. Verified on the droplet with
# `systemd-analyze verify`, which reported "Unknown key name
# 'StartLimitIntervalSec' in section 'Service', ignoring" — the limit was
# silently doing nothing. Five failures inside five minutes stops the unit and
# leaves it stopped for a human, rather than hammering Slack and Google while
# nobody is watching (ARCHITECTURE.md 6).
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple

# Unprivileged, never root (ARCHITECTURE.md section 7).
User=gable
Group=gable
WorkingDirectory=/opt/gable

# VERIFIED: `python -m gable.slackapp.app` is the entry point. app.py has a
# __main__ and main() returns a non-zero exit code on a configuration problem,
# so a missing token stops the unit rather than leaving a healthy-looking
# process that answers nobody.
ExecStart=/opt/gable/.venv/bin/python -m gable.slackapp.app

# .env is chmod 600, owned by gable, and never in git (CLAUDE.md section 3).
# systemd reads it as root before dropping privileges, so gable itself does not
# need read access to anything else in /opt/gable.
EnvironmentFile=/opt/gable/.env

# Unbuffered, or journald shows nothing until the process dies.
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1

# Structured JSON to journald, secrets redacted by logging_setup.py.
StandardOutput=journal
StandardError=journal
SyslogIdentifier=gable

# Restart, but do not crash-loop (ARCHITECTURE.md section 6). The burst limit
# that makes this bounded is in [Unit] above — systemd rejects it here.
Restart=on-failure
RestartSec=15s

# A slow Sheet read must not look like a hang. 30s is well over the poll cycle's
# own timeouts; if the process cannot stop in 30s something is genuinely wedged.
TimeoutStopSec=30s

# --- Hardening -------------------------------------------------------------
# Everything below is filesystem and privilege containment. None of it affects
# outbound network access, which is all Gable needs.
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ProtectClock=true
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true

# ProtectSystem=strict makes the whole filesystem read-only. Gable writes
# exactly two places: the xlsx it builds, and the temp files it streams photos
# through before upload. Nothing else needs to be writable.
ReadWritePaths=/opt/gable/var

# Outbound TCP only. Socket Mode, Google, Firecrawl, and Spaces are all
# AF_INET/AF_INET6; AF_UNIX is kept for journald's socket.
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

# NOTE: no MemoryMax. The droplet is 512MB-class with 1GB of swap, and a hard
# cap there converts a large photo into an OOM kill and then a restart loop —
# the exact failure ARCHITECTURE.md section 6 says to avoid. The real defence is
# streaming images to disk instead of holding them in memory (CLAUDE.md
# section 9). Revisit once the droplet's actual specs are confirmed.

[Install]
WantedBy=multi-user.target
